<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClariNet | Soluciones digitales de negocio</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container nav-wrap">
            <a class="brand" href="#inicio" aria-label="ClariNet">
                <img src="~/images/clarinet-logo.svg" alt="Logo ClariNet" />
            </a>
            <button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false">☰</button>
            <nav class="main-nav" aria-label="Navegación principal">
                <a href="#inicio">Inicio</a>
                <a href="#nosotros">Nosotros</a>
                <a href="#servicios">Servicios</a>
                <a href="#contacto" class="btn btn-small">Contáctanos</a>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-content">
            <div>
                <img src="~/images/clarinet-logo.svg" alt="ClariNet" class="footer-logo" />
                <p>Conectamos estrategia, tecnología y experiencia del cliente para impulsar crecimiento sostenible.</p>
            </div>
            <div>
                <h4>Contacto</h4>
                <p>ventas@clarinet.com.mx</p>
                <p>+52 55 54 36 04 14</p>
                <p>Zapopan, Jalisco</p>
            </div>
            <div>
                <h4>Soluciones</h4>
                <p>Recargas Teléfonos Prepago</p>
                <p>Pago de servicios</p>
                <p>Tarjetas Digitales</p>
            </div>
        </div>
        <p class="copy">© @DateTime.UtcNow.Year ClariNet. Todos los derechos reservados.</p>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
